<div class="ocean-shell ocean-page flex flex-col items-center justify-center min-h-full">
    <div class="ocean-hero max-w-md w-full text-center">
        <div class="ocean-kicker">Coastal mixer mode</div>
        <h1 class="ocean-wordmark">Soc Ops</h1>
        <p class="ocean-subtitle">A bright social bingo board for breezy intros, low-stakes conversation, and finding your people before the tide rolls out.</p>

        <div class="ocean-panel mb-8">
            <h2 class="ocean-panel-title">How the tide works</h2>
            <ul class="ocean-list">
                <li>Find someone in the room who fits the square.</li>
                <li>Tap the tile when you make the match.</li>
                <li>Complete a line to trigger your bingo wave.</li>
            </ul>
        </div>

        <button
            @onclick="OnStart"
            class="ocean-button w-full transition-all">
            Dive In
        </button>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnStart { get; set; }
}
