@using SocOps.Models

<div class="ocean-shell ocean-page flex flex-col min-h-full">
    <div class="ocean-game-card ocean-hero flex flex-col min-h-full">
        <header class="ocean-topbar">
            <button
                @onclick="OnReset"
                class="ocean-button-secondary transition-all">
                ← Shore
            </button>

            <div class="text-center">
                <div class="ocean-badge">Board live</div>
                <h1 class="ocean-heading">Coastal Connections</h1>
                <p class="ocean-copy">Mark each square as you meet someone who fits the prompt. The center is already yours.</p>
            </div>

            <div class="ocean-badge">5 in a row</div>
        </header>

        @if (HasBingo)
        {
            <div class="ocean-bingo-banner">
                Sun on the water: you hit bingo. Keep mingling and see how many lines you can catch.
            </div>
        }

        <div class="ocean-board-shell flex-1 flex items-center justify-center">
            <BingoBoard
                Board="@Board"
                WinningSquareIds="@WinningSquareIds"
                OnSquareClick="@OnSquareClick" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public List<BingoSquareData> Board { get; set; } = new();

    [Parameter]
    public HashSet<int> WinningSquareIds { get; set; } = new();

    [Parameter]
    public bool HasBingo { get; set; }

    [Parameter]
    public EventCallback<int> OnSquareClick { get; set; }

    [Parameter]
    public EventCallback OnReset { get; set; }
}
