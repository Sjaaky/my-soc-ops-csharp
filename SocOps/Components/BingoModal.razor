<div class="ocean-modal-backdrop fixed inset-0 flex items-center justify-center p-4 z-50">
    <div class="ocean-modal max-w-xs w-full shadow-xl">
        <div class="ocean-wave ocean-wave-top"></div>
        <div class="ocean-modal-icon">🌊</div>
        <h2 class="ocean-modal-title">Bingo!</h2>
        <p class="ocean-modal-copy">You completed a line and brought the whole board into sync.</p>
        <p class="ocean-badge mb-4">Keep riding the wave</p>

        <button
            @onclick="OnDismiss"
            class="ocean-button w-full transition-all">
            Back To The Board
        </button>

        <div class="ocean-wave ocean-wave-bottom"></div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnDismiss { get; set; }
}
