@using SocOps.Models

<button
    @onclick="OnClick"
    disabled="@Square.IsFreeSpace"
    class="@GetCssClasses()"
    aria-pressed="@Square.IsMarked"
    aria-label="@(Square.IsFreeSpace ? "Free space" : Square.Text)">
    <span class="ocean-square-text wrap-break-word hyphens-auto">@Square.Text</span>
    @if (Square.IsMarked && !Square.IsFreeSpace)
    {
        <span class="ocean-square-check absolute top-0.5 right-0.5 text-xs">✓</span>
    }
</button>

@code {
    [Parameter]
    public BingoSquareData Square { get; set; } = null!;

    [Parameter]
    public bool IsWinning { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    private string GetCssClasses()
    {
        var baseClasses = "ocean-square relative flex items-center justify-center text-center select-none transition-all duration-150 leading-tight";

        var stateClasses = Square.IsMarked
            ? IsWinning
                ? "ocean-square-winning"
                : "ocean-square-marked"
            : "bg-white ocean-square-default";

        var freeSpaceClasses = Square.IsFreeSpace ? "ocean-square-free font-bold" : string.Empty;

        return $"{baseClasses} {stateClasses} {freeSpaceClasses}";
    }
}
